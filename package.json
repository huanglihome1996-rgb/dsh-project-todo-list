{
  "name": "dsh-project-todo-list",
  "version": "1.0.0",
  "license": "MIT",
  "engines": { "node": ">=22", "dsh": "0.2.2-rc.1" },
  "keywords": ["dsh-plugin", "deepseek-harness", "project-todo", "ai", "github-issues"],
  "type": "module",
  "description": "AI-prioritized personal project todos from default-branch docs and GitHub issues, stored locally in DSH",
  "repository": { "type": "git", "url": "git+ssh://git@github.com/huanglihome1996-rgb/dsh-project-todo-list.git" },
  "homepage": "https://github.com/huanglihome1996-rgb/dsh-project-todo-list#readme",
  "bugs": { "url": "https://github.com/huanglihome1996-rgb/dsh-project-todo-list/issues" },
  "exports": {
    ".": "./src/index.mjs",
    "./client": "./src/client/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["src", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "LICENSE"],
  "scripts": { "test": "node --test test/*.test.mjs" },
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-ui-workspace", "@deepseek-ai/dsh-client-ui-session"] }
  }
}
