{
  "name": "@local/project-todo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI-verified personal next actions from project documents and GitHub issues, stored locally in DSH", 
  "repository": { "type": "git", "url": "git+ssh://git@github.com/huanglihome1996-rgb/dsh-project-todo-list.git" },
  "homepage": "https://github.com/huanglihome1996-rgb/dsh-project-todo-list#readme",
  "bugs": { "url": "https://github.com/huanglihome1996-rgb/dsh-project-todo-list/issues" },
  "exports": {
    ".": "./src/index.mjs",
    "./client": "./src/client/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["src", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-ui-workspace", "@deepseek-ai/dsh-client-ui-session"] }
  }
}
